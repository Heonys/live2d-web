{
  "name": "live2d-jsx",
  "type": "module",
  "version": "0.0.0",
  "description": "Declarative Live2D for React",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./adapters/pixi-v6": "./src/adapters/pixi-v6/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./adapters/pixi-v6": {
        "types": "./dist/adapters/pixi-v6.d.mts",
        "default": "./dist/adapters/pixi-v6.mjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:vitest"
  }
}
