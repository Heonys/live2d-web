{
  "name": "live2d-web",
  "type": "module",
  "version": "0.3.1",
  "description": "Unofficial Live2D Cubism runtime for vanilla JavaScript and React. Brings its own WebGL2 renderer, no Pixi required.",
  "author": "Jiheon Kim (https://github.com/Heonys)",
  "license": "SEE LICENSE IN LICENSES.md",
  "homepage": "https://github.com/Heonys/live2d-web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Heonys/live2d-web.git"
  },
  "bugs": {
    "url": "https://github.com/Heonys/live2d-web/issues"
  },
  "keywords": [
    "live2d",
    "cubism",
    "live2d-cubism",
    "vtuber",
    "webgl",
    "webgl2",
    "react",
    "avatar",
    "lipsync",
    "pixi-live2d-display"
  ],
  "sideEffects": false,
  "imports": {
    "#cubism-framework/*": {
      "types": "./vendor/cubism-web-framework-5-r.5/types/*.d.ts",
      "default": "./vendor/cubism-web-framework-5-r.5/src/*.ts"
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.ts",
    "./tracking/mediapipe": "./src/tracking/mediapipe/index.ts",
    "./backends/cubism-webgl": "./src/backends/cubism-webgl/index.ts",
    "./backends/pixi-v6": "./src/backends/pixi-v6/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./react": {
        "types": "./dist/react.d.mts",
        "default": "./dist/react.mjs"
      },
      "./tracking/mediapipe": {
        "types": "./dist/tracking/mediapipe.d.mts",
        "default": "./dist/tracking/mediapipe.mjs"
      },
      "./backends/cubism-webgl": {
        "types": "./dist/backends/cubism-webgl.d.mts",
        "default": "./dist/backends/cubism-webgl.mjs"
      }
    }
  },
  "files": [
    "LICENSE",
    "LICENSES.md",
    "THIRD_PARTY_NOTICES.md",
    "dist",
    "vendor/cubism-web-framework-5-r.5/LICENSE.md"
  ],
  "scripts": {
    "build": "pnpm build:shader-sources && pnpm build:framework-types && tsdown && node ../../scripts/copy-cubism-shaders.mjs",
    "build:framework-types": "tsc -p vendor/cubism-web-framework-5-r.5/tsconfig.live2d-web.json",
    "build:shader-sources": "node ../../scripts/generate-cubism-shader-sources.mjs",
    "typecheck": "pnpm build:shader-sources && pnpm build:framework-types && tsc --noEmit"
  },
  "peerDependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "react": ">=18.2 <20"
  },
  "peerDependenciesMeta": {
    "@mediapipe/tasks-vision": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "wlipsync": "catalog:"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "catalog:",
    "@pixi/app": "catalog:",
    "@pixi/constants": "catalog:",
    "@pixi/core": "catalog:",
    "@pixi/display": "catalog:",
    "@pixi/extensions": "catalog:",
    "@pixi/interaction": "catalog:",
    "@pixi/loaders": "catalog:",
    "@pixi/math": "catalog:",
    "@pixi/runner": "catalog:",
    "@pixi/settings": "catalog:",
    "@pixi/sprite": "catalog:",
    "@pixi/ticker": "catalog:",
    "@pixi/utils": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "jsdom": "catalog:",
    "pixi-live2d-display": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:vitest"
  }
}
